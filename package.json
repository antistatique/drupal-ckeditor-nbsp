    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-prettier": "^2.6.2",
    "eslint-plugin-react": "^7.10.0",
    "prettier": "^1.15.2",
    "stylelint": "^16.5.0",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^36.0.0",
