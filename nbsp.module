<?php

/**
 * @file
 * Contains nbsp.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\nbsp\Hook\NbspHelpHook;

/**
 * Implements hook_help().
 *
 * Kept for Drupal < 11.1, where OOP hooks are not available.
 */
#[LegacyHook]
function nbsp_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(NbspHelpHook::class)($route_name, $route_match);
}
